{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "HYPERFRAMES_NO_TELEMETRY": "1",
    "HYPERFRAMES_NO_UPDATE_CHECK": "1",
    "HYPERFRAMES_SKIP_SKILLS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(./scripts/hf.sh:*)",
      "Bash(./scripts/novo-video.sh:*)",
      "Bash(./scripts/ajustar-volume.sh:*)",
      "Bash(./scripts/previa.sh:*)",
      "Bash(./scripts/verificar.sh:*)",
      "Bash(./scripts/instalar.sh:*)",
      "Bash(./scripts/roteiro.py:*)",
      "Bash(python3 scripts/roteiro.py:*)",
      "Bash(python scripts/roteiro.py:*)",
      "Bash(./scripts/montar.py:*)",
      "Bash(python3 scripts/montar.py:*)",
      "Bash(python scripts/montar.py:*)",
      "Bash(./scripts/narrar.py:*)",
      "Bash(python3 scripts/narrar.py:*)",
      "Bash(python scripts/narrar.py:*)",
      "WebSearch"
    ],
    "deny": [
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(npx hyperframes publish:*)",
      "Bash(npx hyperframes cloud:*)",
      "Bash(npx hyperframes lambda:*)",
      "Bash(npx hyperframes cloudrun:*)",
      "Bash(npx hyperframes auth:*)",
      "Bash(npx hyperframes feedback:*)",
      "Bash(npx hyperframes upgrade:*)",
      "Bash(npx hyperframes skills:*)",
      "Bash(npx hyperframes@latest:*)",
      "Bash(npx skills:*)",
      "Bash(heygen:*)"
    ]
  }
}
